{
  "name": "nexhealth-js-sdk",
  "version": "1.0.0",
  "description": "",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "prepare": "npm run generate-barrels && npm run generate-resource-exports && npm run build",
    "prepublishOnly": "npm run build",
    "lint:fix": "eslint . --fix && npx prettier --write .",
    "barrels": "barrelsby --directory src/types --location all --singleQuotes --delete",
    "barrels:fix": "tsx scripts/fix-barrels.ts",
    "generate-barrels": "npm run barrels && npm run barrels:fix",
    "generate-resource-exports": "tsx scripts/generate-resource-exports.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Etonio99/nexhealth-js-sdk.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/Etonio99/nexhealth-js-sdk/issues"
  },
  "homepage": "https://github.com/Etonio99/nexhealth-js-sdk#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.6.2",
    "barrelsby": "^2.8.1",
    "eslint": "^10.2.1",
    "globals": "^17.5.0",
    "jiti": "^2.6.1",
    "prettier": "3.8.3",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.0"
  }
}
